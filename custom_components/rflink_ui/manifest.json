  "usb": [
    { "vid": "2341", "pid": "0042" },
    { "vid": "2341", "pid": "0010" },
    { "vid": "2A03", "pid": "0042" },
    { "vid": "2A03", "pid": "0010" },
    { "vid": "1A86", "pid": "7523", "description": "*rflink*" },
    { "vid": "0403", "pid": "6001", "description": "*rflink*" }
  ],
  "version": "2.0.0"
}
