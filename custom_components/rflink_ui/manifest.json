{
  "domain": "rflink_ui",
  "name": "RFLink UI",
  "after_dependencies": ["radio_frequency"],
  "codeowners": ["@guanaco0403", "@DSorlov"],
  "config_flow": true,
  "documentation": "https://github.com/DSorlov/RFLinkUI",
  "integration_type": "hub",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/DSorlov/RFLinkUI/issues",
